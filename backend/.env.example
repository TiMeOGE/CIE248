# Fournisseur IA compatible OpenAI : garder UN seul bloc actif.
# La cle se colle seulement dans backend/.env (jamais dans Git ni dans le chat).

# NVIDIA (https://build.nvidia.com, bouton "Generate API Key", cle nvapi-...)
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=z-ai/glm-5.3
AI_API_KEY=

# OpenRouter (https://openrouter.ai/keys, cle sk-or-...)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4.1-mini
# AI_API_KEY=

# OpenAI : laisser AI_BASE_URL vide (modele par defaut gpt-4.1-mini)
# AI_BASE_URL=
# AI_MODEL=gpt-4.1-mini
# AI_API_KEY=

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
